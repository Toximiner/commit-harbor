{
  "name": "commit-harbor-deploy",
  "version": "1.0.0",
  "private": true,
  "description": "Remote Deployment (SFTP/FTP/FTPS/WebDAV) vendored as the Commit Harbor deploy module. Vendored from https://github.com/akmalyf/remote-deployment v1.1.1 (MIT, Copyright (c) 2026 Akmal); see PROVENANCE.md and LICENSE.",
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.mkdirSync('../dist/media',{recursive:true});for(const f of ['codicon.css','codicon.ttf'])fs.copyFileSync('node_modules/@vscode/codicons/dist/'+f,'../dist/media/'+f)\" && npm run build:webview && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --external:cpu-features --external:*.node --outfile=../dist/deploy.js --minify --sourcemap",
    "build:webview": "esbuild src/webview/sync.ts --bundle --format=iife --target=chrome120 --minify --outfile=../dist/media/sync.js && esbuild src/webview/settings.ts --bundle --format=iife --target=chrome120 --minify --outfile=../dist/media/settings.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/webview",
    "test": "esbuild test/smoke.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscode-stub.ts --external:cpu-features --external:*.node --outfile=../.test/deploy-smoke.js --log-level=warning && node ../.test/deploy-smoke.js"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "ssh2": "^1.17.0",
    "webdav": "^5.11.0"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@ide-diff/viewer": "file:vendor/ide-diff-viewer-0.1.0.tgz",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.140.0",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@ide-diff/core": "file:./vendor/ide-diff-core-0.1.0.tgz"
  }
}
